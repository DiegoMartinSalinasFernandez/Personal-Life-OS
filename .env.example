# Personal Life OS — server environment (names only; never commit real values)
# Core finance/nutrition/activities features need none of these. They enable the
# optional Integrations Center. See docs/INTEGRATIONS.md for step-by-step setup.

# Public origin of the app, exactly as registered with each provider (no trailing slash).
# https required except for http://localhost during development.
APP_BASE_URL=

# ≥32 random characters. Signs the anonymous session cookie.   openssl rand -base64 48
SESSION_SECRET=

# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM).   openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# Credential store: "file" (default, single server; path below) or "supabase".
INTEGRATIONS_STORE=file
INTEGRATIONS_FILE_PATH=.data/integrations.json

# Required when INTEGRATIONS_STORE=supabase. Server-side only — never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (Google Cloud Console → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago (Mercado Pago Developers → Your integrations → application)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Country auth host if needed, e.g. https://auth.mercadopago.com.ar
MERCADOPAGO_AUTH_HOST=https://auth.mercadopago.com
# Keep "true" and enable "Authorization code with PKCE" in the app settings.
MERCADOPAGO_USE_PKCE=true

# Notion (notion.so/profile/integrations → Public integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
